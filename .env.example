DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
JWT_SECRET="remplace-moi-par-une-chaine-aleatoire-longue"
PORT=4000
# Suggestion IA du type d'incident (POST /incidents/suggerer-type) — clé
# gratuite obtenue sur aistudio.google.com (Google AI Studio). Sans cette
# variable, la route renvoie simplement 503 et l'app repasse en sélection
# manuelle du type.
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Email du code d'activation envoyé à la création d'un compte (POST
# /users) ou à sa régénération (PATCH /:id/regenerer-code-activation) —
# via le SMTP de Gmail. GMAIL_APP_PASSWORD est un "mot de passe
# d'application" (Compte Google > Sécurité > Validation en deux étapes >
# Mots de passe des applications), PAS le mot de passe du compte Gmail.
# Sans ces deux variables, l'envoi est simplement ignoré (emailEnvoye:
# false dans la réponse) — le code reste affiché à l'écran pour l'admin,
# qui peut toujours le transmettre lui-même.
GMAIL_USER="tonadresse@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
